{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pg-case-factory:coverage-v2:input-lock:2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "artifact_id", "predecessors", "semantic_payload", "semantic_sha256", "operational_metadata"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "input-lock"},
    "artifact_id": {"type": "string", "minLength": 1},
    "predecessors": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "semantic_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "inputs", "input_count", "input_multiset_sha256"],
      "properties": {
        "scope": {"type": "string", "enum": ["global", "local"]},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relative_path", "version", "semantic_decoder_id", "byte_sha256", "semantic_sha256"],
            "properties": {
              "relative_path": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "semantic_decoder_id": {"type": "string", "enum": ["raw-v1", "utf8-text-v1", "json-v1", "yaml-v1"]},
              "byte_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "input_count": {"type": "integer", "minimum": 1},
        "input_multiset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operational_metadata": {"type": ["object", "null"]}
  }
}
